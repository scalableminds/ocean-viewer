{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
		"types": ["vite/client", "node"],
		"esModuleInterop": true,
		"verbatimModuleSyntax": true,
