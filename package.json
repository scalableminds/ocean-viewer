{
	"name": "ocean-viewer",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"lint": "biome lint .",
		"format": "biome format .",
		"format:write": "biome format --write .",
		"check": "biome check .",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"build": "npm run build --workspaces --if-present"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"typescript": "^7.0.2",
		"vite": "^8.1.0"
	}
}
