{
	"name": "ocean-viewer-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"lint": "biome lint .",
		"format": "biome format .",
		"format:write": "biome format --write .",
		"check": "biome check .",
		"lint:changesets": "node scripts/lint-changesets.js",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"build": "npm run build --workspaces --if-present",
		"changeset": "changeset",
		"version": "changeset version && node scripts/sync-changelog.js",
		"release": "npm run build -w @scalableminds/ocean-viewer && npm run test:smoke -w @scalableminds/ocean-viewer"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.0",
		"typescript": "^7.0.2",
		"vite": "^8.1.0"
	}
}
